# Copy to web/.env on this machine. Never commit web/.env.
# Chat model for the shopping assistant.
OPENAI_BASE_URL=https://xh.v1api.cc/v1
OPENAI_API_KEY=
OPENAI_MODEL=kimi-k2.6
# Live Google search and Google Shopping. Key from https://serper.dev
SERPER_API_KEY=
# Stripe key for checkout. sk_test_... from https://dashboard.stripe.com/test/apikeys
# A live key (sk_live_...) is refused unless HACKU_LIVE=1.
STRIPE_SECRET_KEY=
# 1 = take real payments with a live key. Live orders are HKD only, at most HK$100 each.
HACKU_LIVE=
# Optional second model that rates listings before checkout. Leave empty to use the chat model.
VERIFY_BASE_URL=
VERIFY_API_KEY=
VERIFY_MODEL=
# Optional signing secret for cards and mandates. Leave empty to keep a random one in web/data/secret.key.
HACKU_SECRET=
