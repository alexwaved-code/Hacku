# Copy to web/.env on this machine. Never commit web/.env.
# Chat model for the shopping assistant and the purchase loop.
OPENAI_BASE_URL=https://xh.v1api.cc/v1
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-v4.1-flash
# Live Google search and Google Shopping for Hong Kong. Key from https://serper.dev
SERPER_API_KEY=
# Second model for web/verifier.py (rates listings 1 to 3). verifier.py reads these from the repo-root .env.
VERIFY_API_BASE=
VERIFY_API_KEY=
VERIFY_MODEL=
